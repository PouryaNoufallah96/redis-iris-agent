# ---------------------------------------------------------------------------
# Redis Iris Context Retriever agent — environment template
# Copy to `.env` and fill in your values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# REQUIRED: Context Retriever agent key.
# Redis Cloud console -> your Context Retriever service -> "Agent key" tab ->
# "New Agent Key". Copy it immediately (shown once). Passed to the MCP server
# as the `X-API-Key` header.
CONTEXT_RETRIEVER_AGENT_KEY=

# OPTIONAL: Context Retriever MCP endpoint. Region-pinned. Only set this if your
# service is NOT in the default region below.
# Default: https://gcp-us-east4.context-surfaces.redis.io/mcp
# CTX_MCP_URL=https://gcp-us-east4.context-surfaces.redis.io/mcp

# OPTIONAL: which LLM the agent uses (any Pydantic AI model string).
# Default: anthropic:claude-sonnet-4-6
# Examples: openai:gpt-4o | google-gla:gemini-2.5-pro | groq:llama-3.3-70b-versatile
# MODEL=anthropic:claude-sonnet-4-6

# LLM provider API key — set the one that matches MODEL above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL: Redis Iris **Agent Memory** (managed service).
# Set ALL THREE to give the agent long-term memory (search_memory / store_memory
# tools + per-turn session logging). Leave any blank and the agent runs
# Context-Retriever-only — data, no memory.
# Redis Cloud console -> your Agent Memory service -> Configuration.
# ---------------------------------------------------------------------------
# AGENT_MEMORY_ENDPOINT=https://your-agent-memory-endpoint.redis.io
# AGENT_MEMORY_STORE_ID=
# AGENT_MEMORY_KEY=

# ---------------------------------------------------------------------------
# DEMO SCRIPTS ONLY (seed_northpeak.py / configure_surface.py).
# Not needed to just chat with the agent (Option A). Required for the full
# reproducible demo (Option B): loading data + provisioning a surface.
# ---------------------------------------------------------------------------
# Redis Cloud connection string (Redis Cloud console -> your database -> Connect).
# REDIS_URL=redis://default:<password>@<host>:<port>
#
# Context Retriever ADMIN key (manages the surface + mints agent keys).
# Redis Cloud console -> Context Retriever -> Admin key.
# CTX_ADMIN_KEY=cs_admin_...
